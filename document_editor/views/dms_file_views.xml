<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_dms_file_form_onlyoffice" model="ir.ui.view">
        <field name="name">dms.file.form.onlyoffice</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button
                    name="action_open_onlyoffice"
                    type="object"
                    string="Edit with ONLYOFFICE"
                    class="oe_highlight"
                    icon="fa-pencil-square-o"
                    invisible="not permission_write or extension not in ['docx', 'xlsx', 'pptx', 'csv', 'pdf', 'md']"
                />

            </xpath>

        </field>
    </record>

</odoo>