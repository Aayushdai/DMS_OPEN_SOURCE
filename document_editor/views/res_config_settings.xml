<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">document.editor.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Document Editor" name="document_editor">

                    <block title="ONLYOFFICE">

                        <setting string="ONLYOFFICE URL">
                            <field name="onlyoffice_url"/>
                        </setting>

                        <setting string="ONLYOFFICE Internal URL">
                            <field name="onlyoffice_internal_url"/>
                        </setting>

                        <setting string="Odoo Base URL">
                            <field name="odoo_base_url"/>
                        </setting>

                        <setting string="ONLYOFFICE JWT Secret">
                            <field name="onlyoffice_jwt_secret" password="True"/>
                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>