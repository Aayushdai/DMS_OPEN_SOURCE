<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_supplier_allocation_wizard_form" model="ir.ui.view">
        <field name="name">supplier.allocation.wizard.form</field>
        <field name="model">supplier.allocation.wizard</field>
        <field name="arch" type="xml">

            <form string="Supplier Allocation">

                <sheet>

                    <group>
                        <field name="product_id"/>
                        <field name="required_qty"/>
                    </group>

                    <separator string="Supplier Comparison"/>

                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="partner_id" string="Supplier"/>
                            <field name="price" string="Vendor Price"/>
                            <field name="min_qty" string="Minimum Qty"/>
                            <field name="price_ratio" string="Price Ratio"/>
                            <field name="allocated_qty" invisible="1"/>
                            <field name="supplierinfo_id" invisible="1"/>
                            <field name="max_allocation_qty" invisible="1"/>
                        </list>
                    </field>

                    <field name="error_message"
                           nolabel="1"
                           invisible="not error_message"/>

                    <field name="rfq_created" invisible="1"/>
                    <field name="purchase_order_ids" invisible="1"/>
                    <field name="orderpoint_id" invisible="1"/>
                    <field name="product_uom_id" invisible="1"/>
                    <field name="total_allocated_qty" invisible="1"/>

                </sheet>

                <footer>

                    <button name="action_recalculate"
                            string="Recalculate"
                            type="object"
                            class="btn-secondary"/>

                    <button name="action_create_rfqs"
                            string="Create RFQ"
                            type="object"
                            class="btn-primary"
                            invisible="rfq_created"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>